{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Codespace: Configure team workspace",
      "type": "shell",
      "command": "bash",
      "args": [
        ".devcontainer/scripts/configure-workspace.sh",
        "${input:workspaceName}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Codespace: Verify environment",
      "type": "shell",
      "command": "bash .devcontainer/scripts/verify-environment.sh",
      "problemMatcher": []
    },
    {
      "label": "Codespace: Verify required extensions",
      "type": "shell",
      "command": "bash .devcontainer/scripts/verify-extensions.sh",
      "problemMatcher": []
    },
    {
      "label": "Fabric: Sign in",
      "type": "shell",
      "command": "bash",
      "args": [
        ".devcontainer/scripts/fabric-login.sh",
        "${input:tenantDomain}"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "workspaceName",
      "type": "promptString",
      "description": "Exact assigned writable Fabric workspace name"
    },
    {
      "id": "tenantDomain",
      "type": "promptString",
      "description": "Your commercial-cloud work email or tenant domain (for example, name@contoso.com)"
    }
  ]
}