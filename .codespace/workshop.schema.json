{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fabric Workshop Codespace Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workshopName",
    "protectedWorkspaces",
    "dataHandlingRules",
    "additionalInstructions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "workshopName": {
      "type": "string",
      "minLength": 1
    },
    "protectedWorkspaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "dataHandlingRules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalInstructions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
